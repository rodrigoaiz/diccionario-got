---
import '../styles/global.css';
import { SITE_URL } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Diccionario de Poniente | Nombres y equivalencias',
  description = 'Un atlas bilingüe para orientarse entre nombres, continuidades y lugares de Poniente.',
  noindex = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const siteUrl = SITE_URL;
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, `${siteUrl}/`).href : undefined;
const pageSchema = {
  '@type': 'WebPage',
  '@id': canonicalUrl ? `${canonicalUrl}#page` : undefined,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: 'es',
  isPartOf: siteUrl ? { '@id': `${siteUrl}/#website` } : undefined,
};
const customSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemaGraph = [
  pageSchema,
  ...customSchemas.map(({ '@context': _context, ...schema }) => schema),
];
const serializedSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#18201b" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Diccionario de referencia de Poniente" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={serializedSchema}></script>
    <title>{title}</title>
    {import.meta.env.PROD && (
      <script is:inline type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "y2kwbkdykl");
      </script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
