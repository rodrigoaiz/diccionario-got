---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCollection } from 'astro:content';
import type { DictionaryEntry } from '../../data/entries';
import { getContinuityLabel, getEntrySummary, getRegionLabel } from '../../data/entryPresentation';
import { relationships } from '../../data/relationships';
import { SITE_URL } from '../../config/site';

export async function getStaticPaths() {
  const contentEntries = await getCollection('entries');
  return contentEntries.map(({ data }) => ({
    params: { slug: data.slug },
    props: { entry: { ...data, slug: data.slug } },
  }));
}

const { entry } = Astro.props as { entry: DictionaryEntry };
const allEntries = await getCollection('entries');
const entrySummary = getEntrySummary(entry);
const continuities = entry.continuity.split(' · ').map(getContinuityLabel);
const spoilerLevel = entry.spoilerLevel ?? 'spoiler-total';
const spoilerLabel = {
  'sin-spoiler': 'Sin spoilers',
  'inicio-de-la-obra': 'Inicio de la obra',
  intermedio: 'Intermedio',
  'final-de-la-obra': 'Final de la obra',
  'spoiler-total': 'Spoiler total',
}[spoilerLevel];
const entryRelationships = relationships.filter(
  (relationship) => relationship.source === entry.slug || relationship.target === entry.slug,
);
const siteUrl = SITE_URL;
const entryUrl = new URL(`/diccionario/${entry.slug}/`, `${siteUrl}/`).href;
const alternateNames = [...new Set([entry.nameEn, ...entry.aliases].filter(Boolean))];
const entryIsIndexable = entry.type !== 'Pendiente' && entry.editorialStatus === 'revisada';
---

<BaseLayout
  title={`${entry.nameEs} | Diccionario GOT`}
  description={entrySummary}
  noindex={!entryIsIndexable}
  ogType="article"
  jsonLd={[
    {
      '@type': 'DefinedTerm',
      '@id': entryUrl ? `${entryUrl}#term` : undefined,
      name: entry.nameEs,
      alternateName: alternateNames,
       description: entrySummary,
      termCode: entry.id,
      inLanguage: 'es',
      url: entryUrl,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: siteUrl ? `${siteUrl}/` : undefined,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Diccionario',
          item: siteUrl ? `${siteUrl}/diccionario/` : undefined,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: entry.nameEs,
          item: entryUrl,
        },
      ],
    },
  ]}
>
  <SiteHeader />
  <main class="entry-page shell">
    <a class="back-link" href="/diccionario/"><Icon name="arrow-left" size={16} /> Volver al diccionario</a>

    <header class="entry-header">
      <div>
        <div class="entry-kicker">
          <span class={`entry-dot accent-${entry.accent}`}></span>
          <span>{entry.type}</span>
          <span>·</span>
           <span>{getRegionLabel(entry.region)}</span>
        </div>
        <h1>{entry.nameEs}</h1>
        <p class="entry-original">{entry.nameEn || 'Equivalencia inglesa pendiente'}</p>
      </div>
      <div class="entry-number">Ficha <strong>01</strong></div>
    </header>

    <div class="entry-layout">
      <article class="entry-main">
        <div class="entry-summary">
          <span class="eyebrow">Resumen</span>
          <p>{getEntrySummary(entry)}</p>
        </div>

        <section class="entry-section">
          <span class="eyebrow">Equivalencias y alias</span>
          <div class="alias-list">
            <div class="alias-row"><span>Nombre en español</span><strong>{entry.nameEs}</strong></div>
            {entry.nameEn && <div class="alias-row"><span>Nombre original</span><strong>{entry.nameEn}</strong></div>}
            {entry.aliases.map((alias) => (
              <div class="alias-row"><span>Alias registrado</span><strong>{alias}</strong></div>
            ))}
          </div>
        </section>

        <section class="entry-section">
          <span class="eyebrow">Continuidades</span>
          <div class="continuity-list">
            {continuities.map((continuity, index) => (
              <div class="continuity-row">
                <span>0{index + 1}</span>
                <strong>{continuity}</strong>
                <small>Referencia separada</small>
              </div>
            ))}
          </div>
        </section>

        {entryRelationships.length > 0 && (
          <section class="entry-section">
            <span class="eyebrow">Relaciones</span>
            <div class="relationship-list">
              {entryRelationships.map((relationship) => {
                const isSource = relationship.source === entry.slug;
                const relatedSlug = isSource ? relationship.target : relationship.source;
                const relatedLabel = isSource ? relationship.targetLabel : relationship.sourceLabel;
                const relatedEntry = allEntries.find((item) => item.data.slug === relatedSlug);
                const relatedEnglish = relatedEntry?.data.nameEn;
                return (
                  <div class="relationship-row">
                    <span>{isSource ? relationship.type.replaceAll('_', ' ') : 'relacionado con'}</span>
                    <a href={`/diccionario/${relatedSlug}/`}>
                      <strong>{relatedLabel}</strong>
                      {relatedEnglish && <small>{relatedEnglish}</small>}
                      <Icon name="arrow-up-right" size={16} />
                    </a>
                  </div>
                );
              })}
            </div>
          </section>
        )}

        {entry.references && entry.references.length > 0 && (
          <section class="entry-section">
            <span class="eyebrow">Referencias iniciales</span>
            <div class="reference-list">
              {entry.references.map((reference) => (
                <div class="reference-row">
                  <span class="reference-kind">{reference.kind}</span>
                  <div>
                    <strong>{reference.work}</strong>
                    <p>{reference.detail}</p>
                  </div>
                  <span class="reference-spoiler">{reference.spoilerLevel.replaceAll('-', ' ')}</span>
                </div>
              ))}
            </div>
          </section>
        )}
      </article>

      <aside class="entry-aside">
        <div class="aside-block">
          <span class="eyebrow">Ficha técnica</span>
          <dl class="entry-facts">
            <div><dt>Tipo</dt><dd>{entry.type}</dd></div>
             <div><dt>Región</dt><dd>{getRegionLabel(entry.region)}</dd></div>
            <div><dt>Spoilers</dt><dd class="confidence"><i></i> {spoilerLabel}</dd></div>
            <div><dt>Confianza</dt><dd class="confidence"><i></i> Pendiente de ampliar</dd></div>
          </dl>
        </div>
        <div class="spoiler-note">
          <span class="spoiler-label">{spoilerLevel === 'sin-spoiler' ? 'Lectura segura' : 'Aviso de spoilers'}</span>
          <p>{spoilerLevel === 'sin-spoiler' ? 'Esta ficha no contiene información posterior al inicio de la obra.' : `Esta ficha puede contener información hasta el nivel: ${spoilerLabel}.`}</p>
        </div>
        <div class="source-note">
          <span class="eyebrow">Fuente y fecha</span>
          <p>Registro inicial del proyecto. La procedencia detallada se completará durante la carga editorial.</p>
        </div>
      </aside>
    </div>
  </main>
  <footer class="site-footer shell">
    <span>Diccionario GOT</span>
    <a href="/diccionario/">Otra búsqueda <Icon name="arrow-up-right" size={16} /></a>
  </footer>
</BaseLayout>
