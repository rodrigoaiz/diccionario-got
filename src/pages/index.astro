---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import FactionPicker from '../components/layout/FactionPicker.astro';
import SearchExplorer from '../components/islands/SearchExplorer';
import MapPreview from '../components/atlas/MapPreview.astro';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../config/site';

const contentEntries = await getCollection('entries');
const dictionaryEntries = contentEntries.map(({ data }) => ({ ...data, slug: data.slug }));
const preparedEntries = dictionaryEntries.filter((entry) => entry.type !== 'Pendiente');
const featuredEntries = preparedEntries.slice(0, 4);
---

<BaseLayout
  title="Diccionario GOT | Español e inglés"
  description="Diccionario español-inglés de Juego de Tronos: busca personajes, lugares, casas, dragones y conceptos por nombre o alias."
  jsonLd={{
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    url: SITE_URL,
    name: 'Diccionario GOT',
    description: 'Diccionario español-inglés para consultar nombres, equivalencias y relaciones de Juego de Tronos.',
    inLanguage: 'es',
  }}
>
  <SiteHeader />

  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow reveal-one">Diccionario español <span>↔</span> inglés · Juego de Tronos</p>
        <h1 class="reveal-two">Los nombres de GOT,<br /><em>en ambos idiomas.</em></h1>
        <p class="hero-intro reveal-three">
          Busca personajes, lugares, casas, dragones y conceptos como los recuerdas. Encuentra su equivalente en inglés y sigue tirando del hilo.
        </p>
        <div class="hero-note reveal-four">
          <span class="note-mark">01</span>
          <p><strong>Escribe como te salga.</strong> Aceptamos nombres en español, inglés y alias para que vuelvas rápido a la historia.</p>
        </div>
      </div>

      <aside class="hero-aside" aria-label="Tu bando y estado del diccionario">
        <FactionPicker />
        <div class="hero-index">
          <p class="index-kicker">El diccionario, ahora</p>
          <div class="index-line"><span>Términos indexados</span><strong>{String(preparedEntries.length).padStart(2, '0')}</strong></div>
          <div class="index-line"><span>Qué incluye</span><strong>ES ↔ EN</strong></div>
          <div class="index-line"><span>Estado</span><strong class="status"><i></i> En crecimiento</strong></div>
          <p class="index-caption">Una referencia independiente para leer y ver Juego de Tronos sin perderse en las traducciones.</p>
        </div>
      </aside>

      <div class="hero-search" id="diccionario">
        <div class="hero-search-heading">
          <div>
            <span class="eyebrow">Busca primero</span>
            <h2>¿Qué nombre tienes delante?</h2>
          </div>
          <p>Prueba con español, inglés o un alias. Después puedes filtrar por tipo.</p>
        </div>
        <SearchExplorer entries={dictionaryEntries} client:load />
      </div>
    </section>

    <section class="featured-section shell">
      <div class="section-heading compact-heading">
        <div>
          <span class="eyebrow">Después de encontrarlo</span>
          <h2>Para seguir tirando del hilo</h2>
        </div>
        <a class="text-link" href="#diccionario">Ver todas las entradas <span aria-hidden="true">↗</span></a>
      </div>
      <div class="featured-grid">
        {featuredEntries.map((entry, index) => (
          <a class={`featured-entry featured-${index + 1}`} href={`/diccionario/${entry.slug}/`}>
            <span class={`featured-number accent-${entry.accent}`}>{String(index + 1).padStart(2, '0')}</span>
            <span class="featured-type">{entry.type} <i>·</i> {entry.region}</span>
            <strong>{entry.nameEs}</strong>
            <span class="featured-alias">{entry.nameEn}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="map-section shell" id="mapa">
      <MapPreview />
    </section>

    <section class="method-section shell" id="metodo">
      <div class="method-mark" aria-hidden="true">P</div>
      <div>
        <span class="eyebrow">Nota editorial</span>
        <h2>La procedencia también cuenta una historia.</h2>
      </div>
      <p>Las traducciones, los alias y los hechos no se mezclan sin aviso. Cada ficha irá acompañada de su continuidad, nivel de confianza, fuente y fecha de consulta.</p>
      <a class="text-link" href="#metodo">Conocer el método <span aria-hidden="true">↗</span></a>
    </section>
  </main>

  <footer class="site-footer shell">
    <span>Diccionario GOT</span>
    <span>Lectura en español · Equivalencias en inglés</span>
    <span>Edición abierta · 2026</span>
  </footer>
</BaseLayout>
